#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: bin/make-worklog [--agent <handle>] [--force] <MISSION_ID>

Options:
  --agent <handle>   Agent handle to record in the worklog metadata. Defaults to
                     $MISSION_AGENT, $AGENT_HANDLE, or ".gitconfig" user.name.
  -f, --force        Regenerate the worklog even if it already exists.
  -h, --help         Show this message.

Creates worklogs/<MISSION_ID>/WORKLOG.md using the canonical template with
metadata (mission link, agent, repo state, start date, dependencies) pre-filled.
USAGE
}

die() {
  echo "Error: $*" >&2
  usage >&2
  exit 1
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd "$script_dir/.." && pwd)
template_file="$repo_root/templates/WORKLOG_TEMPLATE.md"
mission_id=""
force=0
agent="${MISSION_AGENT:-${AGENT_HANDLE:-}}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -f|--force)
      force=1
      shift
      ;;
    --agent)
      shift || die "Missing value for --agent"
      agent="$1"
      shift
      ;;
    --agent=*)
      agent="${1#*=}"
      shift
      ;;
    -*)
      die "Unknown option: $1"
      ;;
    *)
      if [[ -n "$mission_id" ]]; then
        die "Multiple mission IDs provided"
      fi
      mission_id="$1"
      shift
      ;;
  esac
done

[[ -n "$mission_id" ]] || die "Mission ID is required"
mission_id=$(echo "$mission_id" | tr 'a-z' 'A-Z')

if [[ ! $mission_id =~ ^M-[0-9]{8}-[0-9]{3}$ ]]; then
  die "Mission ID must match M-YYYYMMDD-###"
fi

mission_file="$repo_root/missions/$mission_id.md"
if [[ ! -f "$mission_file" ]]; then
  die "Mission file not found: missions/$mission_id.md"
fi
if [[ ! -f "$template_file" ]]; then
  die "Template not found at templates/WORKLOG_TEMPLATE.md"
fi

if [[ -z "$agent" ]]; then
  agent=$(git -C "$repo_root" config user.name 2>/dev/null || true)
fi
if [[ -z "$agent" ]]; then
  agent="(set-with--agent)"
fi

start_date=$(date -u +%Y-%m-%d)
iteration_ts=$(date -u +"%Y-%m-%d %H:%M UTC")
branch=$(git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown-branch")
commit=$(git -C "$repo_root" rev-parse --short HEAD 2>/dev/null || echo "unknown-sha")
repo_state="$branch ($commit)"

dependencies_raw=$(awk '
  BEGIN { section=0 }
  /^## Dependencies/ { section=1; next }
  /^## / { if (section) exit }
  section && NF {
    line=$0
    sub(/^[-]\s*/, "", line)
    print line
  }
' "$mission_file")
if [[ -n "$dependencies_raw" ]]; then
  dependencies=$(echo "$dependencies_raw" | paste -sd '; ' -)
else
  dependencies="N/A"
fi

worklog_dir="$repo_root/worklogs/$mission_id"
worklog_file="$worklog_dir/WORKLOG.md"
mkdir -p "$worklog_dir"

if [[ -f "$worklog_file" && $force -eq 0 ]]; then
  die "Worklog already exists at $worklog_file (use --force to overwrite)"
fi

{
  while IFS='' read -r line || [[ -n "$line" ]]; do
    case "$line" in
      '# Worklog – <MISSION_ID>')
        line="# Worklog – $mission_id"
        ;;
      '- Mission: <link or ID>')
        line="- Mission: [$mission_id](../../missions/$mission_id.md)"
        ;;
      '- Agent: <agent-handle>')
        line="- Agent: $agent"
        ;;
      '- Repo state: <branch / commit>')
        line="- Repo state: $repo_state"
        ;;
      '- Start date: <YYYY-MM-DD>')
        line="- Start date: $start_date"
        ;;
      '- Dependencies verified: <list or N/A>')
        line="- Dependencies verified: $dependencies"
        ;;
      '### Iteration 1 – <YYYY-MM-DD HH:MM>')
        line="### Iteration 1 – $iteration_ts"
        ;;
    esac
    printf '%s\n' "$line"
  done < "$template_file"
} > "$worklog_file"

chmod 600 "$worklog_file"
echo "Created $worklog_file"
