{:field_docs
 {:spec/id "Stable slug for this project spec; never reuse between unrelated projects"
  :spec/version "Monotonic integer incremented whenever an approved spec changes"
  :spec/status "One of :draft, :approved, :superseded"
  :metadata/title "Full human-friendly project name"
  :metadata/short_name "Short slug used in folders/IDs"
  :metadata/owner_name "Single accountable human for this spec"
  :metadata/owner_contact "Email or handle for rapid follow-up"
  :vision/summary "Outcome statement in 1-2 sentences; no implementation"
  :vision/problem_statement "Business/user pain the project solves"
  :vision/success_metrics "Quantified targets proving success"
  :stakeholders "Each stakeholder entry must include goals, pain points, success criteria"
  :system_context "Deployment and usage environment info"
  :capabilities "List of what the system must do; never describe steps"
  :constraints "Hard business/technical/operational/legal requirements"
  :data_model "Conceptual entities + fields the system stores"
  :external_systems "Integrations with other platforms"
  :non_functional_requirements "Measurable quality attributes"
  :risks "Potential failure modes with impact/likelihood/mitigation"
  :assumptions "Beliefs that must hold true"
  :acceptance_criteria "Per-capability tests proving work is done"
  :verification_plan "Strategy for running acceptance/regression checks"
  :glossary "Definitions for domain terms"
  :validation_summary "Meta field storing validator output"}

 :spec/id "spec-intuition-core"
 :spec/version 0
 :spec/status :draft
 :metadata {:title "Intuition Core – Self-Describing Delivery"
            :short_name "intuition-core"
            :owner_name "Dami"
            :owner_contact "owner@intuition.dev"
            :created_at "2025-11-17T00:00:00Z"
            :last_updated_at "2025-11-17T00:00:00Z"
            :domain "agentic software delivery"}
 :vision {:summary "Deliver a repository that lets agents capture the entire project specification as structured data, derive workflows, generate missions, and keep the state snapshotting itself."
          :problem_statement "Human owners currently repeat themselves across docs, issue trackers, and agent prompts. We need a single spec->workflow->mission bridge so the system evolves from one place."
          :in_scope ["Meta Agent guided spec intake" "Workflow and mission registry living in repo"
                     "Deterministic mission planning" "Automatic state snapshots for agents"]
          :out_of_scope ["Runtime execution platform" "Human UX beyond textual prompts" "External billing"]
          :success_metrics [{:metric_id :metric/spec-single-source
                              :description "Every project update edits only the structured spec file"
                              :unit "% of changes touching spec"
                              :target_value 100
                              :target_condition "="}
                             {:metric_id :metric/mission-determinism
                              :description "Mission planner output deterministic for same spec"
                              :unit "% runs deterministic"
                              :target_value 100
                              :target_condition "="}]}
 :stakeholders [{:stakeholder_id :stakeholder/owner
                 :role "Owner"
                 :description "Defines the target system and verifies outcomes"
                 :goals ["Express needs once" "Review concise summaries"]
                 :pain_points ["Spec drift" "Repeating instructions"]
                 :success_criteria ["Agents ask precise questions" "Spec snapshots always current"]}
                {:stakeholder_id :stakeholder/meta-agent
                 :role "Meta Agent"
                 :description "Creates specs, workflows, missions"
                 :goals ["Structured inputs" "Deterministic transformations"]
                 :pain_points ["Ambiguous requirements"]
                 :success_criteria ["Zero lint errors" "Registry always versioned"]}
                {:stakeholder_id :stakeholder/mission-executor
                 :role "Mission Executor"
                 :description "Executes workflow-backed missions"
                 :goals ["Clear inputs" "Stable workflows"]
                 :pain_points ["Spec gaps"]
                 :success_criteria ["Every mission references existing workflow"]}
                {:stakeholder_id :stakeholder/pr-gate
                 :role "Verification Agent"
                 :description "Runs final verification missions"
                 :goals ["Single workflow for verification"]
                 :pain_points ["Ad-hoc review"]
                 :success_criteria ["Verification missions include push+merge steps"]}]
 :system_context {:primary_user_segments ["Owner/orchestrator" "Automated agents"]
                  :environments ["local" "CI"]
                  :deployment_context "Git repository hosting structured specs and automation scripts"}
 :capabilities [{:capability_id :cap/spec-intake
                 :name "Structured spec intake"
                 :description "Meta Agent captures and updates the project spec entirely through EDN, enforcing validation after each answer"
                 :priority :must
                 :primary_actor :stakeholder/meta-agent
                 :related_stakeholder_ids [:stakeholder/owner]
                 :preconditions ["Repository initialized" "Owner available"]
                 :triggers ["Owner requests new project or update"]
                 :main_flow ["Agent loads existing spec or template"
                             "Agent interviews owner question by question"
                             "Agent updates EDN and reruns validation"
                             "Agent summarizes and seeks approval"]
                 :alternate_flows ["Owner provides existing structured spec -> agent imports"]
                 :business_rules ["Spec never contains implementation steps"
                                   "Spec approval requires zero validation errors"]
                 :related_data_entity_ids [:entity/project-spec]
                 :related_external_system_ids []}
                {:capability_id :cap/workflow-registry
                 :name "Workflow registry management"
                 :description "Meta Agent defines or updates primitive workflows (inputs/outputs/instructions) and versions them"
                 :priority :must
                 :primary_actor :stakeholder/meta-agent
                 :related_stakeholder_ids [:stakeholder/meta-agent :stakeholder/mission-executor]
                 :preconditions ["Spec approved"]
                 :triggers ["Spec references capability lacking workflows"]
                 :main_flow ["Agent inspects spec capability"
                             "Agent checks registry for matching workflow"
                             "Agent adds new workflow entry if needed with version"
                             "Agent commits registry changes"]
                 :alternate_flows ["Workflow already exists -> reuse"]
                 :business_rules ["Workflows immutable per version" "Commands reference repo scripts"]
                 :related_data_entity_ids [:entity/workflow]
                 :related_external_system_ids []}
                {:capability_id :cap/mission-planning
                 :name "Deterministic mission planning"
                 :description "Meta Agent converts approved spec + workflow registry into mission groups and dependency chains"
                 :priority :must
                 :primary_actor :stakeholder/meta-agent
                 :related_stakeholder_ids [:stakeholder/mission-executor]
                 :preconditions ["Spec approved" "Workflows available"]
                 :triggers ["New approved spec version"]
                 :main_flow ["Load spec and registry"
                             "Generate setup group"
                             "For each capability generate design/implementation/test missions"
                             "Create verification missions"
                             "Persist plan"]
                 :alternate_flows []
                 :business_rules ["Groups independent" "Mission IDs deterministic"]
                 :related_data_entity_ids [:entity/mission :entity/mission-group]
                 :related_external_system_ids []}
                {:capability_id :cap/state-snapshot
                 :name "State snapshot export"
                 :description "System emits consolidated snapshot of all specs, workflows, missions, and worklogs"
                 :priority :should
                 :primary_actor :stakeholder/meta-agent
                 :related_stakeholder_ids [:stakeholder/mission-executor :stakeholder/pr-gate]
                 :preconditions ["Mission plan exists"]
                 :triggers ["After each mission completion"]
                 :main_flow ["Read structured data files"
                             "Produce aggregated EDN/JSON snapshot"
                             "Expose query helpers"]
                 :alternate_flows []
                 :business_rules ["Snapshot build is deterministic" "Snapshot stored in repo"]
                 :related_data_entity_ids [:entity/state-snapshot]
                 :related_external_system_ids []}]
 :constraints {:business ["Single human owner provides requirements"]
               :technical ["Structured files must be valid EDN"
                           "Repository remains tool-agnostic so agents only need terminal access"
                           "Future persistence in Datomic is required"]
               :operational ["Meta Agent operates outside mission system" "Mission executors operate only via missions"]
               :legal []}
 :data_model {:entities [{:entity_id :entity/project-spec
                          :name "ProjectSpec"
                          :description "Declarative definition of target system"
                          :fields [{:field_id :field/spec-id :name "spec-id" :description "Stable identifier" :is_key true :is_required true}
                                   {:field_id :field/spec-status :name "status" :description "Draft, approved" :is_key false :is_required true}]}
                         {:entity_id :entity/workflow
                          :name "Workflow"
                          :description "Reusable primitive work definition"
                          :fields [{:field_id :field/workflow-id :name "workflow-id" :description "Stable slug" :is_key true :is_required true}]}
                         {:entity_id :entity/mission
                          :name "Mission"
                          :description "Single unit of work referencing workflows"
                          :fields [{:field_id :field/mission-id :name "mission-id" :description "Stable slug" :is_key true :is_required true}]}
                         {:entity_id :entity/mission-group
                          :name "MissionGroup"
                          :description "Independent set of missions"
                          :fields [{:field_id :field/group-id :name "group-id" :description "Group identifier" :is_key true :is_required true}]}
                         {:entity_id :entity/state-snapshot
                          :name "StateSnapshot"
                          :description "Aggregated view of current system"
                          :fields [{:field_id :field/snapshot-id :name "snapshot-id" :description "Monotonic identifier" :is_key true :is_required true}]}]
              :cross_entity_rules ["Mission references workflows by id+version"
                                   "Snapshots reference latest spec + mission plan"]}
 :external_systems [{:external_system_id :external/github
                     :name "GitHub"
                     :purpose "Hosts repository and pull requests"
                     :data_exchanged ["git commits" "pull requests"]
                     :constraints ["Must authenticate via PAT" "No forced pushes to main"]}]
 :non_functional_requirements [{:nfr_id :nfr/planning-deterministic
                                :category :reliability
                                :description "Mission planning produces identical output for same inputs"
                                :metric "% deterministic runs"
                                :target_value 100
                                :target_condition "="}
                               {:nfr_id :nfr/spec-roundtrip
                                :category :usability
                                :description "Spec intake round-trip (question -> update -> validation) under 5 seconds"
                                :metric "seconds"
                                :target_value 5
                                :target_condition "≤"}]
 :risks [{:risk_id :risk/spec-ambiguity
          :description "Owner provides ambiguous statements"
          :impact :high
          :likelihood :likely
          :mitigation "Meta Agent lint + targeted follow-up questions"}
         {:risk_id :risk/workflow-drift
          :description "Workflows edited manually"
          :impact :medium
          :likelihood :possible
          :mitigation "Registry stored as EDN with version checks"}]
 :assumptions [{:assumption_id :assumption/agents-have-terminal
                :description "Agents always have terminal + filesystem access"
                :is_critical true}]
 :acceptance_criteria [{:criterion_id :ac/spec-approved
                        :related_capability_ids [:cap/spec-intake]
                        :description "Spec reaches :approved status with zero validation errors"
                        :priority :must
                        :verification_method :inspection}
                       {:criterion_id :ac/workflow-versioning
                        :related_capability_ids [:cap/workflow-registry]
                        :description "Every workflow referenced in missions includes explicit id+version"
                        :priority :must
                        :verification_method :automated_test}
                       {:criterion_id :ac/mission-determinism
                        :related_capability_ids [:cap/mission-planning]
                        :description "Running mission planner twice with same spec+registry yields identical plan files"
                        :priority :must
                        :verification_method :automated_test}
                       {:criterion_id :ac/state-snapshot
                        :related_capability_ids [:cap/state-snapshot]
                        :description "Snapshot command emits unified EDN covering specs, workflows, missions, and worklogs"
                        :priority :should
                        :verification_method :manual_test}]
 :verification_plan {:strategy_summary "Mission executors run workflow-specific tests; verification missions run end-to-end checks before merges"
                     :levels [:unit :integration :system]
                     :environments ["local" "CI"]
                     :regression_policy "Full workflow suite on every mission completion and before merges"}
 :glossary [{:term "Meta Agent" :definition "Planner agent responsible for spec intake, workflow registry, and mission planning"}
            {:term "Mission Executor" :definition "Agent that performs work by following workflow-backed missions"}
            {:term "Mission Group" :definition "Independent set of missions derived from a capability or phase"}]
 :validation_summary {:last_validated_at nil
                      :is_valid false
                      :errors []
                      :warnings []}}
