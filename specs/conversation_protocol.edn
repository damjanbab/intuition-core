;; High-level conversation blueprint for the Meta Agent.
;; Each phase lists the fields it must fill and the example prompts to use.
{:phases [{:phase/id :init
           :description "Bootstrap the spec, ensure metadata exists"
           :fields [:metadata/title :metadata/owner_name :metadata/owner_contact]
           :example_prompts ["What do you call this project?"
                             "Who is responsible for approving the spec?"]}
          {:phase/id :vision
           :description "Capture vision and success metrics"
           :fields [:vision/summary :vision/problem_statement :vision/success_metrics]
           :example_prompts ["Describe what success looks like in a couple sentences."
                             "What problem are we solving for?"
                             "How will we measure success?"]}
          {:phase/id :stakeholders
           :description "Enumerate stakeholders and their goals"
           :fields [:stakeholders]
           :example_prompts ["Who relies on this system?"
                             "What do they need from it?"]}
          {:phase/id :capabilities
           :description "List capabilities/outcomes without implementation"
           :fields [:capabilities]
           :example_prompts ["List the main things the system must do"
                             "For capability %s, who triggers it and what do they see?" ]}
          {:phase/id :constraints
           :description "Capture business/technical/operational constraints"
           :fields [:constraints]
           :example_prompts ["Are there technologies or policies you must follow?"]}
          {:phase/id :data-and-interfaces
           :description "Capture data entities and external systems"
           :fields [:data_model :external_systems]
           :example_prompts ["What information does the system store or manipulate?"
                             "Do we integrate with any external tooling?"]}
          {:phase/id :nfr-and-risks
           :description "Non-functional requirements, risks, assumptions"
           :fields [:non_functional_requirements :risks :assumptions]
           :example_prompts ["Any performance/security expectations?"
                             "What could go wrong?"]}
          {:phase/id :acceptance
           :description "Acceptance criteria and verification plan"
           :fields [:acceptance_criteria :verification_plan]
           :example_prompts ["How do you verify capability %s is complete?"
                             "Describe the verification strategy."]}
          {:phase/id :lint-and-approval
           :description "Resolve validation issues and confirm approval"
           :fields [:validation_summary]
           :example_prompts ["I found this ambiguous statement... can you clarify?"]}]}
