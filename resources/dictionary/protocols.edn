[
 {:protocol/ident :protocol/mission-standard
  :protocol/name "Mission standard"
  :protocol/description "Bootstraps an env, acquires locks, executes tests/docs/system-map refresh, and unlocks."
  :protocol/owner :role/dictionary-engineer
  :protocol/escalation [:role/steward]
  :protocol/invariants [:spec/p3.1 :spec/p3.2 :spec/p4.1 :spec/p4.2 :spec/p5.1 :spec/p9.1]
 :protocol/locks [:lock/dictionary]
 :protocol/required-work-tracks [:work-track/tests :work-track/docs :work-track/system-map]
 :protocol/steps
   [{:step/id :step/mission-sync
    :step/action :action/protocol.run
    :step/description "Execute mission-sync (env bootstrap + branch snapshot) before locks/tests."
    :step/config {:mission/id [:context :mission/id]
                  :agent/id [:context :agent/id]
                  :protocol/ident :protocol/mission-sync
                  :protocol/context {:mission/id [:context :mission/id]
                                     :agent/id [:context :agent/id]
                                     :workspace/root [:context :workspace/root]
                                     :branch/prefix [:context :branch/prefix]}}
    :step/required? true}
   {:step/id :step/acquire-locks
    :step/action :action/lock.acquire
    :step/description "Acquire dictionaries + scope locks"
    :step/config {:mission/id [:context :mission/id]
                  :locks [:protocol :protocol/locks]}
    :step/acquires-locks? true}
   {:step/id :step/lint
    :step/action :action/lint.run
    :step/description "Run governed lint before executing acceptance suites"
    :step/config {:mission/id [:context :mission/id]
                  :lint/paths [:context :lint/paths]
                  :lint/command [:context :lint/command]}
    :step/when [:context :tests/enabled?]
    :step/work-track :work-track/tests
    :step/required? true
    :step/requires-locks? true}
   {:step/id :step/run-tests
    :step/action :action/test.run-suite
    :step/description "Run all declared suites"
    :step/config {:mission/id [:context :mission/id]
                  :test/suite [:context :tests/suite]
                  :test/paths [:context :tests/paths]
                  :test/error-mode [:context :tests/error-mode]}
    :step/when [:context :tests/enabled?]
    :step/work-track :work-track/tests
    :step/required? true
    :step/requires-locks? true}
   {:step/id :step/codetype
    :step/action :action/codetype.validate
    :step/description "Validate touched CodeDefinitions before steward review (§§4.7, 5.1)."
    :step/config {:mission/id [:context :mission/id]
                  :agent/id [:context :agent/id]
                  :codetype/paths [:context :codetype/paths]}
    :step/work-track :work-track/code
    :step/required? true
    :step/requires-locks? true}
   {:step/id :step/docs
    :step/action :action/docs.sync
    :step/description "Sync user/system docs"
    :step/config {:mission/id [:context :mission/id]
                  :docs/paths [:context :docs/paths]}
    :step/work-track :work-track/docs
    :step/required? true
    :step/requires-locks? true}
   {:step/id :step/system-map
    :step/action :action/system-map.refresh
    :step/description "Refresh system map nodes"
    :step/config {:mission/id [:context :mission/id]
                  :system-map/entities [:context :system-map/entities]}
    :step/work-track :work-track/system-map
    :step/required? true
    :step/requires-locks? true}
   {:step/id :step/release-locks
    :step/action :action/lock.release
    :step/description "Release dictionaries + scope locks"
    :step/config {:mission/id [:context :mission/id]
                  :locks [:protocol :protocol/locks]}
    :step/releases-locks? true}]}
